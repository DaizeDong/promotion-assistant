{
  "schema_version": 1,
  "repository_kind": "skill",
  "configuration": "settings",
  "rationale": "Runtime behavior consumes a selected PRIVATE product configuration and validates capability-specific readiness.",
  "documentation": [
    "README.md",
    "README_CN.md",
    "CONFIG.md",
    "DATA.md"
  ],
  "settings": {
    "schema_document": "CONFIG.md",
    "discovery_document": "CONFIG.md",
    "environment": "PROMOTION_ASSISTANT_CONFIG",
    "aliases": [],
    "precedence": [
      "--config / --config-dir",
      "PROMOTION_ASSISTANT_CONFIG",
      "proven sibling companion"
    ],
    "required_fields": [
      "product.schema_version",
      "product.name",
      "registry.schema_version",
      "registry.channels[].slug",
      "registry.channels[].platform"
    ],
    "initializer": {
      "path": "skills/promotion-assistant/scripts/init_config.py",
      "args": [
        "--out",
        "{output}"
      ]
    },
    "doctor": {
      "path": "skills/promotion-assistant/scripts/verify_config.py",
      "args": []
    }
  }
}
